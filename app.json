{
  "expo": {
    "name": "Zabaan E Kisaan",
    "slug": "zabaan-e-kisaan",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdulahad0118.zabaanekisaan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby agricultural services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location helps farmers find nearby resources."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCQGJsBgJBOPHiiSV8xBVpESPm1RHyd7dM"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4CAF50"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.abdulahad0118.zabaanekisaan",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCQGJsBgJBOPHiiSV8xBVpESPm1RHyd7dM"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFCFB",
          "image": "./assets/images/splash-icon-dark.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83838cc1-9992-4053-b72b-a4353b7170a8"
      }
    }
  }
}
